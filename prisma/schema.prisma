generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  createdAt DateTime @default(now())

  items UserItem[]

  accounts        Account[]
  sessions        Session[]
  collections     Collection[]
  collectionItems CollectionItem[]
  customItems     CustomItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id String @id @default(cuid())

  // NEW
  category String?

  // Display fields
  name     String
  set      String
  game     String
  imageUrl String?

  itemNumber String?
  rarity     String?
  setCode    String?

  isCustom        Boolean @default(false)
  createdByUserId String?

  purchasePrice Float?  // what the user paid for the item
  marketPrice   Float?  // current market value

  userItems       UserItem[]
  prices          ItemPrice[]
  collectionItems CollectionItem[]

  @@unique([game, setCode, itemNumber], name: "game_setCode_itemNumber")
  @@unique([game, setCode, name], name: "game_setCode_name")
  @@unique([name, set, game], name: "name_set_game")

  @@index([game])
  @@index([setCode])
  @@index([name])
}

model UserItem {
  id            String @id @default(cuid())
  userId        String
  itemId        String
  quantity      Int    @default(1)
  purchasePrice Float?

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId], name: "userId_itemId")
}

model ItemPrice {
  id          String   @id @default(cuid())

  // Which item this price belongs to
  itemId      String

  // Current market price we fetched or stored
  marketPrice Float

  // Where the price came from
  // Examples: "manual", "tcgplayer", "pricecharting"
  source      String   @default("manual")

  // When this price record was created
  createdAt   DateTime @default(now())

  // When this price entry was last updated
  lastUpdated DateTime @updatedAt

  // Relation back to the item
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Helpful indexes for searching and sorting price history
  @@index([itemId])
  @@index([source])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]
  customItems CustomItem[]

  @@unique([userId, name])
}

model CollectionItem {
  id            String   @id @default(cuid())
  userId        String
  collectionId  String
  itemId        String
  quantity      Int      @default(1)

  // Price the user paid per item
  purchasePrice Float?

  // Manual market price override for this owned row
  marketPrice   Float?

  // Condition of the user's owned item
  // Examples:
  // - Near Mint
  // - Played
  // - Sealed
  // - Painted
  // - Unpainted
  condition     String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item          Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemId])
}

model CustomItem {
  id            String   @id @default(cuid())
  userId        String
  collectionId  String
  name          String
  game          String?
  set           String?
  imageUrl      String?
  quantity      Int      @default(1)
  purchasePrice Float?
  marketPrice   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}
