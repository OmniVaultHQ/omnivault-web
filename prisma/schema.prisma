generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  createdAt DateTime @default(now())

  cards UserCard[]

  accounts        Account[]
  sessions        Session[]
  collections     Collection[]
  collectionItems CollectionItem[]
  customItems CustomItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Card {
  id String @id @default(cuid())

  // Display fields
  name     String
  set      String
  game     String
  imageUrl String?

  // Catalog identity fields
  cardNumber String? // ex: "ST01-001"
  rarity     String? // ex: "C", "R", "SR"
  setCode    String? // ex: "ST01"

  // ✅ NEW: separates catalog vs custom cards
  isCustom        Boolean @default(false)
  createdByUserId String? // null = catalog/imported

  userCards       UserCard[]
  prices          CardPrice[]
  collectionItems CollectionItem[]

  // ✅ BEST unique for catalog cards that have real numbers
  @@unique([game, setCode, cardNumber], name: "game_setCode_cardNumber")
  // ✅ Fallback unique (prevents dupes when cardNumber is missing)
  @@unique([game, setCode, name], name: "game_setCode_name")
  @@index([game])
  @@index([setCode])
  @@index([name])
}

model UserCard {
  id            String @id @default(cuid())
  userId        String
  cardId        String
  quantity      Int    @default(1)
  purchasePrice Float?

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId], name: "userId_cardId")
}

model CardPrice {
  id          String   @id @default(cuid())
  cardId      String
  marketPrice Float
  lastUpdated DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
  customItems CustomItem[]

  @@unique([userId, name])
}

model CollectionItem {
  id            String @id @default(cuid())
  userId        String
  collectionId  String
  cardId        String
  quantity      Int    @default(1)
  purchasePrice Float?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collectionId, cardId])
  @@index([collectionId])
  @@index([cardId])
  @@index([userId])
}
model CustomItem {
  id            String   @id @default(cuid())
  userId        String
  collectionId  String
  name          String
  game          String?
  set           String?
  imageUrl      String?
  quantity      Int      @default(1)
  purchasePrice Float?
  marketPrice   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}
