generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  createdAt DateTime @default(now())

  items UserItem[]

  accounts        Account[]
  sessions        Session[]
  collections     Collection[]
  collectionItems CollectionItem[]
  customItems     CustomItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/*
Master source of imported catalog data.

Examples:
- pokemon
- onepiece
- gundam
- marvel-legends
- nike
*/
model CatalogSource {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String?  // cards, figures, shoes, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collections CatalogCollection[]

  @@index([category])
}

/*
A release group, set, wave, season, or product line
that belongs to a catalog source.

Examples:
- Base Set
- Scarlet & Violet
- Wave 3
- Summer 2024 Releases
*/
model CatalogCollection {
  id           String   @id @default(cuid())
  sourceId     String
  externalId   String?  // ID from outside API if available
  name         String
  code         String?  // set code / wave code / release code
  type         String?  // set, wave, season, release, series
  releaseDate  DateTime?
  imageUrl     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source       CatalogSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items        Item[]

  @@unique([sourceId, externalId])
  @@unique([sourceId, name, code])
  @@index([sourceId])
  @@index([name])
  @@index([code])
}

/*
Master catalog item.

This is NOT the user's owned item.
This is the shared catalog entry all users can add from.
*/
model Item {
  id String @id @default(cuid())

  catalogCollectionId String?

  // Broad category
  category String?

  // Display fields
  name     String
  set      String
  game     String
  imageUrl String?

  // Common collectible fields
  itemNumber String?
  rarity     String?
  setCode    String?

  // External sync fields
  externalId String?
  externalUrl String?

  // Flexible metadata for future categories
  metadata Json?

  isCustom        Boolean @default(false)
  createdByUserId String?

  // Optional cached market data on the catalog item itself
  purchasePrice Float?
  marketPrice   Float?

  // When a pricing refresh last tried this item (any outcome). Used to skip
  // items checked recently so refreshes are fast and save API quota.
  priceCheckedAt DateTime?

  catalogCollection CatalogCollection? @relation(fields: [catalogCollectionId], references: [id], onDelete: SetNull)

  userItems       UserItem[]
  prices          ItemPrice[]
  collectionItems CollectionItem[]

  @@unique([game, setCode, itemNumber], name: "game_setCode_itemNumber")
  

  @@index([catalogCollectionId])
  @@index([game])
  @@index([setCode])
  @@index([name])
  @@index([externalId])
}

model UserItem {
  id            String @id @default(cuid())
  userId        String
  itemId        String
  quantity      Int    @default(1)
  purchasePrice Float?

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId], name: "userId_itemId")
}

model ItemPrice {
  id          String   @id @default(cuid())
  itemId      String
  marketPrice Float
  source      String   @default("manual")

  // ISO 4217 currency of marketPrice
  currency    String   @default("USD")
  // high | medium | low (null for rows saved before this was tracked)
  confidence  String?
  // number of listings/sales behind the price (eBay), when known
  sampleSize  Int?
  // when the provider itself last updated this price (e.g. TCGplayer updatedAt)
  providerUpdatedAt DateTime?

  createdAt   DateTime @default(now())
  // bumped whenever a refresh re-confirms this price
  lastUpdated DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([source])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]
  customItems CustomItem[]

  @@unique([userId, name])
}

model CollectionItem {
  id            String   @id @default(cuid())
  userId        String
  collectionId  String
  itemId        String
  quantity      Int      @default(1)

  // Price the user paid per owned item
  purchasePrice Float?

  // Manual or synced market price for this owned row
  marketPrice   Float?

  // If true, automatic pricing refresh should not overwrite this row
  manualPriceLocked Boolean @default(false)

  // manual, simulated, tcgplayer, ebay, pricecharting, etc.
  priceSource   String?

  lastPriceUpdated DateTime?

  // User-owned condition
  condition     String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, collectionId])
  @@index([userId])
  @@index([collectionId])
  @@index([itemId])
}

model CustomItem {
  id            String   @id @default(cuid())
  userId        String
  collectionId  String
  name          String
  game          String?
  set           String?
  imageUrl      String?
  quantity      Int      @default(1)
  purchasePrice Float?
  marketPrice   Float?
  priceSource   String?
  lastPriceUpdated DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}